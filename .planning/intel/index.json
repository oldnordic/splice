{
  "project": {
    "name": "splice",
    "version": "2.0.0",
    "description": "Span-safe refactoring kernel for 7 languages using tree-sitter and SQLiteGraph",
    "language": "Rust",
    "license": "GPL-3.0-or-later"
  },
  "architecture": {
    "paradigm": "Command-line tool with library components",
    "core_modules": [
      {
        "name": "graph",
        "purpose": "SQLiteGraph integration layer with Magellan support",
        "responsibilities": [
          "Symbol storage",
          "Span queries",
          "Relationship management"
        ],
        "key_types": [
          "CodeGraph",
          "NodeId"
        ]
      },
      {
        "name": "ingest",
        "purpose": "Filesystem → AST → SQLiteGraph ingestion pipeline",
        "responsibilities": [
          "File parsing",
          "Symbol extraction",
          "Language dispatch"
        ],
        "supported_languages": [
          "Rust",
          "Python",
          "C",
          "C++",
          "Java",
          "JavaScript",
          "TypeScript"
        ]
      },
      {
        "name": "patch",
        "purpose": "Span-safe replacement with validation",
        "responsibilities": [
          "Byte-accurate edits",
          "AST validation",
          "Batch operations"
        ]
      },
      {
        "name": "validate",
        "purpose": "Tree-sitter + compiler validation gates",
        "responsibilities": [
          "Syntax validation",
          "Compiler checks",
          "Checksum verification"
        ]
      },
      {
        "name": "plan",
        "purpose": "JSON plan orchestration",
        "responsibilities": [
          "Multi-step refactoring",
          "Deterministic ordering",
          "Error handling"
        ]
      },
      {
        "name": "execution",
        "purpose": "Execution logging audit trail",
        "responsibilities": [
          "Operation tracking",
          "Timestamps",
          "Command-line capture"
        ]
      },
      {
        "name": "output",
        "purpose": "Structured JSON output",
        "responsibilities": [
          "V2.0 schema",
          "Span-aware metadata",
          "Deterministic ordering"
        ]
      },
      {
        "name": "checksum",
        "purpose": "SHA-256 verification hooks",
        "responsibilities": [
          "Pre/post-operation checksums",
          "Integrity verification"
        ]
      }
    ]
  },
  "dependencies": {
    "core": [
      {
        "name": "magellan",
        "version": "0.5.3",
        "features": [
          "native-v2"
        ],
        "purpose": "Code indexing and label queries"
      },
      {
        "name": "sqlitegraph",
        "version": "1.0",
        "features": [
          "native-v2"
        ],
        "purpose": "SQLiteGraph re-exported from Magellan"
      },
      {
        "name": "tree-sitter",
        "version": "0.22",
        "purpose": "AST parsing for validation"
      }
    ],
    "cli": [
      "clap",
      "env_logger",
      "log"
    ],
    "utilities": [
      "ropey",
      "sha2",
      "glob",
      "tempfile"
    ],
    "time": [
      "uuid",
      "chrono"
    ],
    "storage": [
      "rusqlite"
    ]
  },
  "commands": {
    "refactor": [
      {
        "name": "delete",
        "purpose": "Remove symbol definitions and all references",
