          "Rust (full)",
          "Python/C/C++/Java/JS/TS (basic)"
        ],
        "features": [
          "Cross-file resolution",
          "Shadowing handling",
          "Import tracking"
        ]
      },
      {
        "name": "patch",
        "purpose": "Replace function bodies, class definitions, etc.",
        "supported_languages": [
          "All 7 languages"
        ],
        "features": [
          "Single/batch operations",
          "Preview mode",
          "Backup support"
        ]
      },
      {
        "name": "apply-files",
        "purpose": "Multi-file pattern replacement with AST confirmation",
        "features": [
          "Glob patterns",
          "Language detection",
          "Validation gates"
        ]
      },
      {
        "name": "plan",
        "purpose": "Orchestrate multi-step refactors via JSON plans",
        "features": [
          "Deterministic ordering",
          "Error handling",
